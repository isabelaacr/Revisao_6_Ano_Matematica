// ---------- LISTA: GRANDEZA UNIFICADA (velocidade/vazão/densidade/escala) ----------
const grandezaLabels = {
  velocidade: { a:'Distância (km)', b:'Tempo (h)', c:'Velocidade (km/h)', formula:'Velocidade = distância ÷ tempo' },
  vazao:      { a:'Volume (L)', b:'Tempo (min)', c:'Vazão (L/min)', formula:'Vazão = volume ÷ tempo' },
  densidade:  { a:'População (hab)', b:'Área (km²)', c:'Densidade (hab/km²)', formula:'Densidade = população ÷ área' },
  escala:     { a:'Distância no mapa (cm)', b:'Distância real (km)', c:'Escala (1 : ___)', formula:'Escala = distância no mapa ÷ distância real' },
};

function setupGrandezaUnificada(){
  const type = document.getElementById('gu-type').value;
  const L = grandezaLabels[type];
