}

function resolverGrandeza(){
  const type = document.getElementById('gu-type').value;
  const L = grandezaLabels[type];
  const aRaw = document.getElementById('gu-a').value;
  const bRaw = document.getElementById('gu-b').value;
  const cRaw = document.getElementById('gu-c').value;
  const a = aRaw===''? null : parseFloat(aRaw);
  const b = bRaw===''? null : parseFloat(bRaw);
  const c = cRaw===''? null : parseFloat(cRaw);
  const missing = [a,b,c].filter(v=>v===null).length;
  if(missing!==1){ showResult('gu-result', 'Preencha exatamente dois valores e deixe o terceiro em branco — ele é o que vamos descobrir!'); return; }

  if(type==='escala'){
    // a = mapa (cm), b = real (km), c = escala (1:c)
    if(c===null){
      const realCm = b*100000;
      const result = realCm/a;
      showResult('gu-result', `<div class="big">1 : ${result.toLocaleString('pt-BR')}</div>Convertendo ${b} km para cm: ${realCm.toLocaleString('pt-BR')} cm. Escala = ${realCm.toLocaleString('pt-BR')} ÷ ${a} = 1 : ${result.toLocaleString('pt-BR')}`);
    } else if(a===null){
      const realCm = b*100000;
      const result = realCm/c;
      showResult('gu-result', `<div class="big">${result} cm</div>Distância real em cm: ${b} km = ${realCm.toLocaleString('pt-BR')} cm. Distância no mapa = ${realCm.toLocaleString('pt-BR')} ÷ ${c} = ${result} cm`);
    } else {
      const realCm = a*c;
      const result = realCm/100000;
      showResult('gu-result', `<div class="big">${result} km</div>Distância real em cm = ${a} × ${c} = ${realCm.toLocaleString('pt-BR')} cm = ${result} km`);
    }
    return;
  }

  let result, steps;
  if(c===null){
    result = a/b;
    steps = `${L.formula} = ${a} ÷ ${b} = ${result}`;
  } else if(a===null){
    result = b*c;
    steps = `${L.a.split('(')[0].trim()} = ${L.c.split('(')[0].trim()} × ${L.b.split('(')[0].trim()} = ${c} × ${b} = ${result}`;
  } else {
    result = a/c;
    steps = `${L.b.split('(')[0].trim()} = ${L.a.split('(')[0].trim()} ÷ ${L.c.split('(')[0].trim()} = ${a} ÷ ${c} = ${result}`;
  }
  showResult('gu-result', `<div class="big">${result}</div>${steps}`);
}

// ---------- LISTA: PORCENTAGEM — TRÊS MODOS ----------
function setupPercentMode(){
  const mode = document.getElementById('pm-mode').value;
  const wrap = document.getElementById('pm-fields');
  if(mode==='valor'){
    wrap.innerHTML = `<div><label>Porcentagem (%)</label><input type="number" id="pm-pct" value="35"></div>
      <div><label>Valor total</label><input type="number" id="pm-total" value="75"></div>`;
  } else if(mode==='percentual'){
    wrap.innerHTML = `<div><label>Parte</label><input type="number" id="pm-parte" value="18"></div>
      <div><label>Total</label><input type="number" id="pm-total2" value="60"></div>`;
  } else {
    wrap.innerHTML = `<div><label>Valor antes</label><input type="number" id="pm-antes" value="20"></div>
      <div><label>Valor depois</label><input type="number" id="pm-depois" value="27"></div>`;
  }
  document.getElementById('pm-result').classList.remove('show');
}

function calcPercentMode(){
  const mode = document.getElementById('pm-mode').value;
  if(mode==='valor'){
    const pct = parseFloat(document.getElementById('pm-pct').value);
    const total = parseFloat(document.getElementById('pm-total').value);
    const r = (pct/100)*total;
    showResult('pm-result', `<div class="big">${r}</div>${pct}% de ${total} = (${pct}/100) × ${total} = ${r}`);
  } else if(mode==='percentual'){
    const parte = parseFloat(document.getElementById('pm-parte').value);
    const total = parseFloat(document.getElementById('pm-total2').value);
    const r = (parte/total*100);
    const rTxt = r.toFixed(2).replace(/\.00$/,'');
    showResult('pm-result', `<div class="big">${rTxt}%</div>${parte} é a fração ${parte}/${total} do total. (${parte}/${total}) × 100 = ${rTxt}%`);
  } else {
    const antes = parseFloat(document.getElementById('pm-antes').value);
    const depois = parseFloat(document.getElementById('pm-depois').value);
    const diff = depois-antes;
    const r = (diff/antes*100);
    const rTxt = Math.abs(r).toFixed(2).replace(/\.00$/,'');
    const tipo = diff>=0 ? 'aumento' : 'desconto';
    showResult('pm-result', `<div class="big">${rTxt}% de ${tipo}</div>Diferença: ${depois} − ${antes} = ${diff}. Variação percentual = (${diff}/${antes}) × 100 = ${r.toFixed(2).replace(/\.00$/,'')}%`);
  }
}

// ---------- LISTA: CONVERSOR PORCENTAGEM ↔ FRAÇÃO ↔ DECIMAL ----------
function setupConverter(){
  const type = document.getElementById('cv-type').value;
  const wrap = document.getElementById('cv-fields');
  if(type==='fracao'){
    wrap.innerHTML = `<div><label>Numerador</label><input type="number" id="cv-num" value="23"></div>
      <div style="flex:0; padding-bottom:8px; font-weight:700;">/</div>
      <div><label>Denominador</label><input type="number" id="cv-den" value="100"></div>`;
  } else if(type==='porcentagem'){
    wrap.innerHTML = `<div><label>Porcentagem (%)</label><input type="number" id="cv-pct" value="55"></div>`;
  } else {
    wrap.innerHTML = `<div><label>Número decimal</label><input type="number" step="0.01" id="cv-dec" value="0.46"></div>`;
  }
  document.getElementById('cv-result').classList.remove('show');
}

function calcConverter(){
  const type = document.getElementById('cv-type').value;
  let dec;
  if(type==='fracao'){
    const n = parseFloat(document.getElementById('cv-num').value);
    const d = parseFloat(document.getElementById('cv-den').value);
    dec = n/d;
  } else if(type==='porcentagem'){
    dec = parseFloat(document.getElementById('cv-pct').value)/100;
  } else {
    dec = parseFloat(document.getElementById('cv-dec').value);
  }
  const pctVal = dec*100;
  let numer = dec, denom = 1, guard = 0;
  while(Math.abs(numer - Math.round(numer)) > 1e-9 && guard < 6){ numer *= 10; denom *= 10; guard++; }
  numer = Math.round(numer);
  const g = gcd(numer, denom);
  const fracN = numer/g, fracD = denom/g;
  showResult('cv-result',
    `<div class="visual-wrap" style="align-items:center;">
       <div class="grid100 mini">${gridCellsHTML(pctVal)}</div>
       <div><div class="big">${pctVal.toFixed(2).replace(/\.00$/,'')}%</div>Fração irredutível: ${fracN}/${fracD}  •  Decimal: ${dec}</div>
     </div>`);
}


