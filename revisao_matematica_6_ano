// ---------- HELPERS ----------
function gcd(a,b){ a=Math.abs(a); b=Math.abs(b); while(b){ [a,b]=[b,a%b]; } return a || 1; }

function showResult(id, html){
  const el = document.getElementById(id);
  el.innerHTML = html;
  el.classList.add('show');
}

function checkNumberAnswer(inputId, correct, fbId, explanation, tolerance=0.5){
  const val = parseFloat(document.getElementById(inputId).value);
  const fb = document.getElementById(fbId);
  if(isNaN(val)){ fb.className='feedback wrong'; fb.innerHTML='Digite um número.'; return; }
  if(Math.abs(val-correct) <= tolerance){
    fb.className='feedback correct'; fb.innerHTML='✅ Isso mesmo! Resposta: '+correct;
  } else {
    fb.className='feedback wrong';
    fb.innerHTML = `❌ Ainda não é isso. Resposta certa: <strong>${correct}</strong>` +
      (explanation ? `<div style="font-weight:400; margin-top:5px;">💡 ${explanation}</div>` : '');
  }
}

function checkFractionAnswer(inputId, correct, explanation){
  const raw = document.getElementById(inputId).value.trim().replace(/\s/g,'');
  const fb = document.getElementById(inputId+'-fb');
  const norm = f => {
    const parts = f.split('/');
    if(parts.length!==2) return null;
    const n = parseInt(parts[0]), d = parseInt(parts[1]);
    if(isNaN(n)||isNaN(d)||d===0) return null;
    const g = gcd(n,d);
    return (n/g)+'/'+(d/g);
  };
  const userNorm = norm(raw);
  const correctNorm = norm(correct);
  if(userNorm && userNorm===correctNorm){
    fb.className='feedback correct'; fb.innerHTML='✅ Correto! '+correct;
  } else {
    fb.className='feedback wrong';
    fb.innerHTML = `❌ Quase lá. Resposta certa: <strong>${correct}</strong>` +
      (explanation ? `<div style="font-weight:400; margin-top:5px;">💡 ${explanation}</div>` : '');
  }
}

