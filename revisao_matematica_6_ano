function gridCellsHTML(percent){
  const filled = Math.max(0, Math.min(100, Math.round(percent)));
  let html = '';
  for(let i=0;i<100;i++){ html += `<div class="cell${i<filled?' filled':''}"></div>`; }
  return html;
}

function convertFraction(){
  const num = parseFloat(document.getElementById('frac-num').value);
  const den = parseFloat(document.getElementById('frac-den').value);
  if(!den){ showResult('frac-result','Digite um denominador válido.'); return; }
  const pct = (num/den*100);
  const g = gcd(num,den);
  const simpN = num/g, simpD = den/g;
  const overflowNote = pct>100 ? ` (mais que o quadriculado inteiro — ${pct.toFixed(1)}% no total)` : '';
  showResult('frac-result',
    `<div class="visual-wrap" style="align-items:center;">
       <div class="grid100 mini">${gridCellsHTML(pct)}</div>
       <div>
         <div class="big">${pct.toFixed(2).replace(/\.00$/,'')}%</div>
         Fração irredutível: ${simpN}/${simpD}<br>
         ${num}/${den} = ${simpN}/${simpD} = ${pct.toFixed(2).replace(/\.00$/,'')}/100${overflowNote}
       </div>
     </div>`);
}

// ---------- PIZZA VISUALS (fraction types) ----------
function pizzaSliceHTML(filled, total){
  if(total<=0) return '';
  const step = 360/total;
  let parts = [];
  for(let i=0;i<total;i++){
    const color = i<filled ? 'var(--coral)' : '#F3E9D2';
    parts.push(`${color} ${(i*step).toFixed(2)}deg ${((i+1)*step).toFixed(2)}deg`);
  }
  return `<div><div class="pizza" style="background:conic-gradient(${parts.join(',')})"></div><div class="pizza-label">${filled}/${total}</div></div>`;
}

function renderTypePizza(){
  const num = parseInt(document.getElementById('tp-num').value);
  const den = parseInt(document.getElementById('tp-den').value);
  const box = document.getElementById('tp-pizzas');
  const out = document.getElementById('tp-classification');
  if(!den || den<1 || isNaN(num) || num<0){ box.innerHTML=''; out.innerHTML='Digite um numerador e um denominador válidos (denominador maior que zero).'; return; }
  const whole = Math.floor(num/den);
  const rem = num % den;
  let html = '';
  const cappedWhole = Math.min(whole, 6); // avoid drawing dozens of pizzas
  for(let i=0;i<cappedWhole;i++){ html += pizzaSliceHTML(den, den); }
  if(rem>0 || whole===0){ html += pizzaSliceHTML(rem, den); }
  if(whole>6){ html += `<div class="pizza-label" style="align-self:center;">... e mais ${whole-6} pizza(s) inteira(s)</div>`; }
  box.innerHTML = html;

  let cls;
  if(num % den === 0){
    cls = `🟢 <strong>Fração aparente</strong> — ${num}/${den} dá um número inteiro certinho: ${num/den}.`;
  } else if(num < den){
    cls = `🔵 <strong>Fração própria</strong> — o numerador é menor que o denominador: é menos que uma pizza inteira.`;
  } else {
    cls = `🟠 <strong>Fração imprópria</strong> — o numerador é maior que o denominador: é mais que uma pizza inteira! Como número misto: ${whole} inteiro${whole!==1?'s':''}${rem>0?` e ${rem}/${den}`:''}.`;
  }
  out.innerHTML = cls;
}

