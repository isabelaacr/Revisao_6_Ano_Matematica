// ---------- LISTA: OPERAÇÕES COM FRAÇÕES ----------
function calcFracOp(){
  const n1 = parseFloat(document.getElementById('fo-n1').value);
  const d1 = parseFloat(document.getElementById('fo-d1').value);
  const op = document.getElementById('fo-op').value;
  const n2 = parseFloat(document.getElementById('fo-n2').value);
  const d2 = parseFloat(document.getElementById('fo-d2').value);
  if(!d1 || !d2){ showResult('fo-result', 'O denominador não pode ser zero.'); return; }
  let resN, resD, steps;
  if(op==='vezes'){
    resN = n1*n2; resD = d1*d2;
    steps = `${n1}/${d1} × ${n2}/${d2} = (${n1}×${n2})/(${d1}×${d2}) = ${resN}/${resD}`;
  } else if(op==='dividido'){
    resN = n1*d2; resD = d1*n2;
    steps = `${n1}/${d1} ÷ ${n2}/${d2}  →  guarda, troca, inverte  →  ${n1}/${d1} × ${d2}/${n2} = ${resN}/${resD}`;
  } else if(op==='mais'){
    resN = n1*d2 + n2*d1; resD = d1*d2;
    steps = `${n1}/${d1} + ${n2}/${d2} = (${n1}×${d2} + ${n2}×${d1}) / (${d1}×${d2}) = (${n1*d2} + ${n2*d1}) / ${resD} = ${resN}/${resD}`;
  } else {
    resN = n1*d2 - n2*d1; resD = d1*d2;
    steps = `${n1}/${d1} − ${n2}/${d2} = (${n1}×${d2} − ${n2}×${d1}) / (${d1}×${d2}) = (${n1*d2} − ${n2*d1}) / ${resD} = ${resN}/${resD}`;
  }
  const g = gcd(resN, resD);
  const simpN = resN/g, simpD = resD/g;
  const simplifiedNote = (Math.abs(simpN)!==Math.abs(resN)) ? `  →  simplificando por ${Math.abs(g)}: ${simpN}/${simpD}` : '  (já é irredutível)';
  showResult('fo-result', `<div class="big">${simpN}/${simpD}</div>${steps}${simplifiedNote}`);
}

