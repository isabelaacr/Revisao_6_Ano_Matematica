];
let quizAnswered = 0, quizScore = 0;

function renderQuiz(){
  const container = document.getElementById('quiz-container');
  container.innerHTML='';
  quizAnswered = 0; quizScore = 0;
  document.getElementById('quiz-score-box').classList.remove('show');
  quizData.forEach((item, qi)=>{
    const div = document.createElement('div');
    div.className='quiz-q';
    div.innerHTML = `<div class="q-text">${qi+1}. ${item.q}</div><div class="quiz-opts" id="qopts-${qi}"></div><div class="feedback wrong" id="qexplain-${qi}" style="display:none;"></div>`;
    container.appendChild(div);
    const optsWrap = div.querySelector(`#qopts-${qi}`);
    item.opts.forEach((opt, oi)=>{
      const b = document.createElement('button');
      b.className='opt'; b.textContent = opt;
      b.onclick = ()=> answerQuiz(qi, oi, b, optsWrap);
      optsWrap.appendChild(b);
    });
  });
}

function answerQuiz(qi, oi, btn, wrap){
  if(wrap.dataset.locked) return;
  wrap.dataset.locked = "1";
  const correct = quizData[qi].correct;
  Array.from(wrap.children).forEach((b, idx)=>{
    b.disabled = true;
    if(idx===correct) b.classList.add('reveal-correct');
  });
  if(oi===correct){ btn.classList.add('picked-correct'); quizScore++; }
  else {
    btn.classList.add('picked-wrong');
    const exp = document.getElementById(`qexplain-${qi}`);
    exp.innerHTML = `💡 ${quizData[qi].explain}`;
    exp.style.display = 'block';
  }
  quizAnswered++;
  if(quizAnswered===quizData.length){
    document.getElementById('quiz-score').textContent = quizScore+'/'+quizData.length;
    document.getElementById('quiz-score-box').classList.add('show');
  }
}

